[flake8]
max-line-length = 88
max-complexity = 10
exclude = 
    .git,
    __pycache__,
    */migrations/*,
    */venv/*,
    */env/*,
    build,
    dist,
    .tox,
    .coverage,
    .pytest_cache,
    node_modules

ignore = 
    E203,
    E501,
    W503

per-file-ignores =
    */settings/*.py:E501,F401
    */test*.py:E501
    manage.py:E402